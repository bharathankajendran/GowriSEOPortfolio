APP_NAME="G2VERTEX Digital Growth Agency"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# =========================================================================
# SINGLE POINT DATABASE CONNECTOR
# All database connections are driven from this single block:
# =========================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gowri_seo_portfolio
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache Drivers
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# =========================================================================
# SINGLE POINT EMAIL / MAIL CONNECTOR
# Used by ContactController for sending client inquiries:
# =========================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="contact@g2vertex.com"
MAIL_FROM_NAME="${APP_NAME}"
